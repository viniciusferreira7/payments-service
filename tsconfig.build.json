{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // This config emits, which is incompatible with the base config's
    // allowImportingTsExtensions/noEmit pair. The .mts files that need
    // allowImportingTsExtensions are excluded below.
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "vitest.shared.mts",
    "vitest.config.mts",
    "vitest.config.int.mts",
    "vitest.config.e2e.mts"
  ]
}
