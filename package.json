{
  "name": "payments-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write",
    "start": "nest start --exec 'node --env-file-if-exists=.env --require @viniciusferreira7/signals/register'",
    "start:dev": "nest start --watch --exec 'node --env-file-if-exists=.env --require @viniciusferreira7/signals/register'",
    "start:debug": "nest start --debug --watch --exec 'node --env-file-if-exists=.env --require @viniciusferreira7/signals/register'",
    "start:prod": "node --env-file-if-exists=.env --require @viniciusferreira7/signals/register dist/main",
    "lint": "biome lint --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:int": "vitest run --config ./vitest.config.int.mts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@viniciusferreira7/signals": "1.0.0",
    "amqplib": "2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "passport-jwt": "4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "undici": "8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "1.15.43",
    "@types/amqplib": "0.10.8",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
