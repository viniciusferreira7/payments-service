NODE_ENV=dev
PORT=3335

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5433/payments"
DATABASE_PORT=5433
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=payments

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1s

# Test infrastructure (docker compose `test` profile) — throwaway containers
# the int/e2e lanes connect to, kept apart from the dev Postgres on 5433.
DATABASE_TEST_PORT=5434
DATABASE_TEST_USERNAME=test
DATABASE_TEST_PASSWORD=test
DATABASE_TEST_NAME=payments_test

# RabbitMQ — this service CONSUMES the queue the checkout service publishes to.
RABBITMQ_URL="amqp://admin:admin@localhost:5672"
RABBITMQ_TEST_URL="amqp://test:test@localhost:5673"
RABBITMQ_QUEUE_PAYMENTS=payment_queue
RABBITMQ_EXCHANGE=payments
RABBITMQ_ROUTING_KEY_PAYMENT_ORDER=payment.order
# Retry policy for a failed consume: attempts before the message is dead
# lettered, and how long it waits in `<queue>.retry` between them.
RABBITMQ_RETRY_MAX_ATTEMPTS=3
RABBITMQ_RETRY_DELAY_MS=30000

# Observability (@viniciusferreira7/signals)
# These are read by the `--require @viniciusferreira7/signals/register` preload,
# which runs BEFORE Nest's ConfigModule loads this file. Exporting them in the
# real process environment is therefore required; the entries here document the
# expected values and feed the non-preload fallback path.
OTEL_SERVICE_NAME=payments-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# Payment service
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=your-api-key

